# Production. Inside production/:  cp env.production.example .env && chmod 600 .env
# This is production/.env, separate from the repo-root dev .env. Do not reuse dev values.

DEBUG=0
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Needs the settings.py change in production/deploy/settings.diff
ALLOWED_HOSTS=church-management.canzana.xyz
CSRF_TRUSTED_ORIGINS=https://church-management.canzana.xyz

POSTGRES_DB=jilchurch
POSTGRES_USER=jilchurch_user
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Compose-level options (optional)
WEB_PORT=8090
# Must match the host user that owns production/data  (run: id -u && id -g)
APP_UID=1000
APP_GID=1000